{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:helix:adapter:sigil:v1",
  "title": "Helix Sigil adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "correlationId", "identity", "capability", "arguments"],
  "properties": {
    "contract": { "const": "helix-adapter.v1" },
    "correlationId": { "type": "string", "pattern": "^corr_[a-z0-9-]+$", "maxLength": 128 },
    "identity": { "$ref": "#/$defs/identity" },
    "capability": { "type": "string", "pattern": "^sigil\\.[a-z0-9_.-]+$" },
    "arguments": { "type": "object", "maxProperties": 64, "additionalProperties": true }
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["windowsIdentity", "icfIdentity", "sigilIdentity"],
      "properties": {
        "windowsIdentity": { "type": "string", "minLength": 1 },
        "icfIdentity": { "type": "string", "minLength": 1 },
        "sigilIdentity": { "type": "string", "minLength": 1 }
      }
    }
  }
}
