{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:helix:adapter:icf:v1",
  "title": "Helix ICF adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "correlationId", "identity", "query", "governed"],
  "properties": {
    "contract": { "const": "helix-adapter.v1" },
    "correlationId": { "type": "string", "pattern": "^corr_[a-z0-9-]+$", "maxLength": 128 },
    "identity": { "$ref": "#/$defs/identity" },
    "query": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "governed": { "type": "boolean" }
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["windows", "helixSession"],
      "properties": {
        "windows": { "$ref": "#/$defs/windows" },
        "helixSession": { "$ref": "#/$defs/helixSession" },
        "icf": { "$ref": "#/$defs/authority" },
        "sigil": { "$ref": "#/$defs/authority" }
      }
    },
    "windows": {
      "type": "object", "additionalProperties": false,
      "required": ["sid", "upn", "groups"],
      "properties": {
        "sid": { "type": "string", "minLength": 1 },
        "upn": { "type": "string", "minLength": 1 },
        "groups": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "helixSession": {
      "type": "object", "additionalProperties": false,
      "required": ["sessionId", "correlationId", "createdAt", "governed"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlationId": { "type": "string", "pattern": "^corr_[a-z0-9-]+$", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "governed": { "type": "boolean" }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    }
  }
}
